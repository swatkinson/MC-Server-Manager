# Setup: Replace <your-username> with your Linux username before installing.
# Install: sudo cp mc-server-manager.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now mc-server-manager
[Unit]
Description=MC Server Manager Dashboard
After=network.target

[Service]
Type=simple
User=<your-username>
WorkingDirectory=/home/<your-username>/mc-server-manager
ExecStart=/usr/bin/node /home/<your-username>/mc-server-manager/dist/backend/server.js
Restart=always
RestartSec=5s
# Only stop the Node process on restart/deploy. The default (control-group)
# would also kill a Minecraft server the panel launched via start.sh/screen.
KillMode=process
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mc-server-manager
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Environment="NODE_ENV=production"
Environment="PORT=80"
Environment="MINECRAFT_DIR=/home/<your-username>/MinecraftServer"
Environment="JWT_SECRET=<your-jwt-secret>"

[Install]
WantedBy=multi-user.target
