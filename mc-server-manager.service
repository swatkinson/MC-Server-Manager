[Unit]
Description=MC Server Manager Dashboard
After=network.target

[Service]
Type=simple
User=swatkinson
WorkingDirectory=/home/swatkinson/mc-server-manager
ExecStart=/usr/bin/node /home/swatkinson/mc-server-manager/dist/backend/server.js
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mc-server-manager
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Environment="NODE_ENV=production"
Environment="PORT=80"
Environment="MINECRAFT_DIR=/home/swatkinson/MinecraftServer"

[Install]
WantedBy=multi-user.target
