[Unit]
Description=MC Server Manager Dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mc-server-manager
ExecStart=/usr/bin/node /home/ubuntu/mc-server-manager/dist/backend/server.js
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mc-server-manager

Environment="NODE_ENV=production"
Environment="PORT=3001"
Environment="MINECRAFT_DIR=/home/ubuntu/MinecraftServer"

[Install]
WantedBy=multi-user.target
