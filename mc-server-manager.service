[Unit]
Description=MC Server Manager Dashboard
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/mc-server-manager
ExecStart=/usr/bin/node /opt/mc-server-manager/dist/backend/server.js
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mc-server-manager

Environment="NODE_ENV=production"
Environment="PORT=80"
Environment="MINECRAFT_DIR=/home/minecraft/server"

[Install]
WantedBy=multi-user.target
