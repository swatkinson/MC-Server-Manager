# Required
JWT_SECRET=<generate with: openssl rand -base64 48>

# Server paths (set MINECRAFT_DIR, rest auto-derive)
MINECRAFT_DIR=/home/your-user/MinecraftServer
# STORAGE_PATH=           # Where to store app config/users (default: MINECRAFT_DIR)
# WORLD_PATH=             # Override world dir (default: auto-detect from level-name in server.properties)
# LOG_PATH=               # Override log file path (default: MINECRAFT_DIR/logs/latest.log)
# START_SCRIPT=           # Override start.sh path (default: MINECRAFT_DIR/start.sh)
# SERVER_PROPERTIES_PATH= # Override server.properties path (default: MINECRAFT_DIR/server.properties)

# Server console
# MC_SCREEN_SESSION=minecraft   # Name of the screen session (default: minecraft)

# Network
# PORT=3001              # HTTP port (default: 3001 dev, 80 prod via systemd)

# Backups (host-side mc-world-backup job, reached through mc-backup-gateway over SSH)
# BACKUP_HOST=root@192.168.0.99            # Gateway host (also settable on the Backups page)
# BACKUP_SSH_KEY=~/.ssh/mc-backup-gateway  # Key restricted to the gateway forced command
